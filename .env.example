# =============================================================================
# Parcer — пример переменных окружения.
# Скопируйте в .env и заполните своими значениями. .env в git не попадает.
# =============================================================================

# ------------------------------------------------------------------ Telegram bot
BOT_TOKEN=                  # токен бота от @BotFather
BOT_ACCESS_PASSWORD=        # пароль для доступа к боту (авторизация пользователей)
BOT_ADMINS=                 # telegram user_id админов, через запятую: 111111,222222
BOT_ALLOWED_USERS=          # telegram user_id белого списка, через запятую
BOT_USERS_TABLE=bot_users   # таблица подписок/авторизаций в PostgreSQL
BOT_TZ=Europe/Moscow
LOG_DIR=logs

# Рассылки/дайджесты (rps, размеры выгрузок, top-N для сводок)
BROADCAST_RPS=25
DIGEST_TZ=Europe/Moscow
DIGEST_TICK_SEC=60
DIGEST_MAX_ROWS=5000
DIGEST_TOP_N=60
DIGEST_MAX_TOPICS=5
DIGEST_MAX_BULLETS_PER_TOPIC=4
DIGEST_MAX_HTML_CHARS=3500
DIGEST_SEND_TOPIC_EXPORTS=1
DIGEST_TOPIC_EXPORT_MAX_ROWS=5000

# ------------------------------------------------------------------ PostgreSQL
# Можно задать одной строкой PG_DSN — она имеет приоритет над остальными.
PG_DSN=
PG_USER=postgres
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres

# Имена VIEW/MATVIEW с данными
TG_VIEW=feedback_raw_v3      # устаревший алиас TG_VIEW_RAW
TG_VIEW_RAW=feedback_raw_v3
TG_VIEW_THREADS=thread_docs_all

# ------------------------------------------------------------------ Telethon (сбор из Telegram)
TG_API_ID=                  # api_id приложения Telegram (my.telegram.org)
TG_API_HASH=                # api_hash приложения Telegram
TG_SESSION_FILE=transport_feedback_tg.session
# Источники: списки через запятую либо файлы channels.txt / groups.txt / discussions.txt / chats.txt рядом со скриптом
TG_CHANNELS=
TG_GROUPS=
TG_DISCUSSIONS=
TG_CHATS=
# Прокси (опционально)
TG_PROXY=
TG_PROXY_TYPE=
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USER=
TG_PROXY_PASSWORD=
TG_PROXY_RDNS=true
# Частота логов ингеста
INGEST_LOG_EVERY=500
INGEST_LOG_EVERY_POSTS=500
INGEST_LOG_EVERY_COMMENTS=500
INGEST_LOG_EVERY_BACKFILL=500

# ------------------------------------------------------------------ Эмбеддинги и семантический поиск
EMBED_PROVIDER=local                 # local | gigachat
EMBEDDER=intfloat/multilingual-e5-base
EMBED_DEVICE=cuda                    # cuda | cpu | mps
EMB_BATCH=256
EMB_BATCH_SIZE=128
EMB_TRUNC=1200
FILTER_NOISE=1
NOISE_MAX_LEN=60

# FAISS: индекс по "тредам" (пост + комментарии)
SEM_USE_FAISS=1
FAISS_THREADS_DIR=./faiss_threads_store
FAISS_MODEL=intfloat/multilingual-e5-base
FAISS_DEVICE=cpu
FAISS_TOP_K=120
FAISS_MIN_SCORE_THREADS=0.42
FAISS_STRICT_TOKENS_MAX=2
FAISS_RELOAD_ON_CHANGE=1

# FAISS: индекс по "микротредам" (склейки сообщений из чатов)
SEM_USE_MICRO=1
FAISS_MICRO_DIR=./faiss_micro
FAISS_MICRO_TOP_K=120
FAISS_MIN_SCORE_MICRO=0.45
MICRO_THRESHOLD=0.82
MICRO_SESSION_GAP_MIN=90
MICRO_SESSION_MAX_MSGS=1200
MICRO_DOC_MAX_MSGS=80
MICRO_MIN_CLUSTER_SIZE=3
MICRO_CHAT_KINDS=chat,group,discussion,chat_msg

# ------------------------------------------------------------------ GigaChat (эмбеддинги и/или LLM)
GIGACHAT_AUTH_KEY=          # Authorization key (base64 client_id:client_secret)
GIGACHAT_CREDENTIALS=       # альтернативное имя того же ключа
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_EMBED_MODEL=Embeddings-2
GIGACHAT_EMBED_BATCH=1
GIGACHAT_MODEL=
GIGACHAT_RETRIES=2
GIGACHAT_TIMEOUT=180
GIGACHAT_TIMEOUT_SEC=180
GIGACHAT_VERIFY_SSL=1
GIGACHAT_VERIFY_SSL_CERTS=1
GIGACHAT_CA_BUNDLE_FILE=    # путь к CA-бандлу, если нужен свой

# ------------------------------------------------------------------ LLM (Ollama / GigaChat) для сводок
SUMMARY_PROVIDER=gigachat   # gigachat | ollama
USE_OLLAMA=1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_RETRIES=2
OLLAMA_TIMEOUT_SEC=180
SUMMARY_OLLAMA_HOST=http://127.0.0.1:11434
SUMMARY_OLLAMA_MODEL=qwen2.5:7b-instruct
SUMMARY_USE_OLLAMA=1
LLM_CTX=8192
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.15
LLM_TOP_P=0.9

# ------------------------------------------------------------------ Сводки / кластеризация
SUMMARY_USE_THREADS=1
SUMMARY_TOP_N=60
SUMMARY_TOPN=120
SUMMARY_DF_CAP=12000
SUMMARY_MIN_DOCS_FOR_LLM=5
SUMMARY_MAX_BULLETS=8
SUMMARY_MIN_BULLETS=4
SUMMARY_POOL_MULT=6
SUMMARY_SKIP_SEM=0
TAG_BATCH_SIZE=12
TAGS_PER_COMMENT_MAX=3
SUMMARY_GEO_MAX_LINES=2
SUMMARY_GEO_MAX_STATIONS=3
SUMMARY_GEO_MIN_MENTION_COUNT=2

# ------------------------------------------------------------------ Экспорт результатов
COUNT_EXPORT_MAX=100000
EXAMPLES_EXPORT_MAX=2000
XLSX_ROWS_MAX=30000
XLSX_WIDE_COL=110
CSV_ROWS_MAX=100000
CSV_IMPORT_DIR=incoming_csv
MAX_EXAMPLE_CHARS=1100
MAX_COMMENT_CHARS=900
THREAD_BODY_MAX_CHARS=30000
EXPORT_THREAD_BODY_MAX_CHARS=3500
EXPORT_THREAD_HEAD_LINES=4
EXPORT_THREAD_KEY_LINES=8
EXPORT_THREAD_TAIL_LINES=2

# ------------------------------------------------------------------ Скоуп / эвристики ответа
STATIONS_CSV=stations.csv
COUNT_FAISS_TOP_K=3000
COUNT_MICRO_TOP_K=3000
COUNT_MIN_SCORE_MICRO=0.78
COUNT_MIN_SCORE_THREADS=0.78
QA_CONTEXT_TOP_K=12
QA_DF_CAP=40
QA_MAX_BULLETS=5
QA_MAX_CONTEXT_CHARS=1500
QA_MAX_CONTEXT_ITEMS=10
QA_MAX_TOKENS=900
QA_MIN_AND_HITS=2
QA_AND_RATIO=6.0
QA_PREVIEW_EXAMPLES=3
LEX_AND_MIN=1
LEX_AND_RATIO=8.0

# ------------------------------------------------------------------ Кэш и пайплайн
DATA_TTL_SEC=600
CACHE_BUST_CHECK_EVERY_SEC=3
CACHE_BUST_FILE=.data_updated
PIPELINE_TZ=Europe/Moscow
PIPELINE_LOCK_TTL_MIN=180
PIPELINE_FORCE_REBUILD=
PIPELINE_BUILD_EVERY_TIME=
PIPELINE_BUILD_WINDOW=
PIPELINE_INGEST_SCRIPT=
PIPELINE_INGEST_ARGS=
PIPELINE_BUILD_MICRO_SCRIPT=
PIPELINE_BUILD_THREADS_SCRIPT=
PIPELINE_EMBED_DEVICE=
PIPELINE_REFRESH_THREAD_MV=

# ------------------------------------------------------------------ Прочее
# Каталог проекта для Parcerrun_ingest.cmd (по умолчанию — родительский каталог скрипта)
PARCER_HOME=
